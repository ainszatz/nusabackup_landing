# Supabase — public keys (safe for client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase — server-only (never in NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notifications — server-only
RESEND_API_KEY=re_your-resend-api-key
FONNTE_TOKEN=your-fonnte-token

# Admin notification targets — server-only
ADMIN_NOTIFY_EMAIL=admin@nusabackup.id
ADMIN_NOTIFY_WA=628123456789
