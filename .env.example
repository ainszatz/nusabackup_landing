# Copy to .env.production and fill in real values before `docker compose up`.
# NEXT_PUBLIC_* values are also passed as build args in docker-compose.yml.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nusabackup.id

# ── Notifications (optional — skip to disable) ────────────────────────────────
RESEND_API_KEY=re_...
ADMIN_NOTIFY_EMAIL=admin@nusabackup.id
FONNTE_TOKEN=your-fonnte-token
ADMIN_NOTIFY_WA=628123456789

# ── Development (optional, ignored in production) ─────────────────────────────
# Extra origins allowed to reach the dev server, comma-separated.
# Example: a Tailscale hostname. Not needed for the live site.
ALLOWED_DEV_ORIGINS=
