# Copy to .env.production, fill in real values, then run:
#   docker compose --env-file .env.production up -d --build
#
# NEXT_PUBLIC_* values are baked into the client bundle at build time, so they
# must be present in the environment Compose interpolates (--env-file), not just
# in the container's runtime environment. Non-public secrets are only read at
# runtime and never reach the browser.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nusabackup.id

# ── Notifications (optional — leave empty to disable) ─────────────────────────
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=admin@nusabackup.id
FONNTE_TOKEN=
ADMIN_NOTIFY_WA=628123456789
